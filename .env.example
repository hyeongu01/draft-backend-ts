DATABASE_URL=mysql://johndoe:randompassword@localhost:3306/mydb
MYSQL_ROOT_PASSWORD=randompassword
PORT=3000

# OAuth 완료 후 토큰을 들고 리다이렉트할 프론트 주소 (CORS origin 으로도 사용)
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fsdfaf

JWT_ACCESS_SECRET=secret1
JWT_REFRESH_SECRET=secret2

# 운영: 'production' 일 때 쿠키 Secure=true
NODE_ENV=development
# 운영: app/api 공통 부모 도메인 (예: .example.com). 로컬은 비워둠
COOKIE_DOMAIN=

# Cloudflare R2 (대시보드 > R2 > API 토큰에서 발급)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=draft
# 버킷 공개 도메인 (대시보드 > R2 > 버킷 > 설정 > 공개 액세스에서 r2.dev 허용 후 표시되는 주소)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
