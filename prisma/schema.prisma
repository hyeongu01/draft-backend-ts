generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id       String @id @default(uuid()) @db.Char(36)
  nickname String @db.VarChar(255)
  email    String @unique @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  auths  UserAuth[]
  tokens RefreshToken[]

  @@map("users")
}

model UserAuth {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  provider   String @db.VarChar(20) // github, google
  providerId String @map("provider_id") @db.VarChar(255)

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([provider, providerId])
  @@map("user_auths")
}

model RefreshToken {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  deviceId String? @map("device_id") @db.Char(36) // 디바이스에서 생성한 uuid 값 (추후 필요 시 사용)
  token    String  @db.Char(64) // refreshToken 의 sha256 해시값

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  @@unique([deviceId, userId])
  @@map("refresh_tokens")
}
