generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id       String @id @default(ulid()) @db.Char(26)
  nickname String @db.VarChar(255)
  email    String @unique @db.VarChar(255) // 탈퇴 시 `removed-${id}@deleted.local` 형식으로 뭉갬

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  auths   UserAuth[]
  tokens  RefreshToken[]
  resumes Resume[]
  likes   ResumeLike[]
  scraps  ResumeScrap[]

  @@map("users")
}

model UserAuth {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  provider   String @db.VarChar(20) // github, google
  providerId String @map("provider_id") @db.VarChar(255)

  userId String @map("user_id") @db.Char(26)
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([provider, providerId])
  @@map("user_auths")
}

model RefreshToken {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  deviceId String @map("device_id") @db.Char(26) // 디바이스에서 생성한 ulid 값
  token    String @db.Char(64) // refreshToken 의 sha256 해시값

  userId String @map("user_id") @db.Char(26)
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  @@unique([deviceId, userId])
  @@map("refresh_tokens")
}

model Resume {
  id          String  @id @default(ulid()) @db.Char(26)
  title       String  @db.VarChar(255)
  description String  @db.VarChar(1000) // 짧은 설명
  content     Json    @db.Json
  likeCount   Int     @default(0) @map("like_count") @db.UnsignedInt
  scrapCount  Int     @default(0) @map("scrap_count") @db.UnsignedInt
  careerYears Int     @map("career_years") @db.UnsignedInt
  isPublic    Boolean @default(false) @map("is_public") @db.TinyInt

  userId     String      @map("user_id") @db.Char(26)
  user       User        @relation(fields: [userId], references: [id])
  categoryId Int         @map("category_id") @db.UnsignedInt
  category   JobCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  likes  ResumeLike[]
  scraps ResumeScrap[]

  @@map("resumes")
}

model ResumeLike {
  userId   String @map("user_id") @db.Char(26)
  user     User   @relation(fields: [userId], references: [id])
  resumeId String @map("resume_id") @db.Char(26)
  resume   Resume @relation(fields: [resumeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([userId, resumeId])
  @@map("resume_likes")
}

model ResumeScrap {
  userId   String @map("user_id") @db.Char(26)
  user     User   @relation(fields: [userId], references: [id])
  resumeId String @map("resume_id") @db.Char(26)
  resume   Resume @relation(fields: [resumeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([userId, resumeId])
  @@map("resume_scraps")
}

model JobGroup {
  id   Int    @id @default(autoincrement()) @db.UnsignedInt
  name String @unique @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  categories JobCategory[]

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("job_groups")
}

model JobCategory {
  id   Int    @id @default(autoincrement()) @db.UnsignedInt
  name String @db.VarChar(255)

  groupId Int      @map("group_id") @db.UnsignedInt
  group   JobGroup @relation(fields: [groupId], references: [id])

  isActive  Boolean  @default(true) @map("is_active") @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  resumes Resume[]

  @@unique([name, groupId])
  @@map("job_categories")
}
